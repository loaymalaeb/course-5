bool guess3LetterPassowrd(string passowrd){
    int trial=1;
    string word="";
    for(char i='A';i<='Z';i++){
        for(char j='A';j<='Z';j++){
            for(char k='A';k<='Z';k++){
                word=word+i;
                word=word+j;
                word=word+k;
                cout<<"Trial ["<<trial<<"]: "<<word<<endl;
                if(word==passowrd){
                   cout<<"Password is "<<passowrd<<endl;
                   cout<<"Found after "<<trial<<" Trial(s)"<<endl;
                   return true;
                }
                trial++;
                word="";

            }
        }
    }
    return false;
}
    
