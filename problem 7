#include <string>
int readPositiveNumber(string message){
  int number;
  do{
  cout<<message<<endl;
  cin>>number;
}while(number<=0);
return number;
}


int getReversedNumber(int number){
    string reversed="";
    int remainder=0;
    while(number>0){
        remainder=number%10;
        reversed+=to_string(remainder);
        number/=10;
    }
    return stoi(reversed);
}

int main()
{   
    int rev=getReversedNumber(readPositiveNumber("enter a positve number"));
    cout<<"reverse is "<<rev<<endl;
    return 0;
}
