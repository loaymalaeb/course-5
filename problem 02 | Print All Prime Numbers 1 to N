#include <iostream>   // Include the iostream library for input/output operations
using namespace std;  // Use the standard namespace to avoid using the "std::" prefix



enum enPrimeOrNotPtime{prime=1,notPrime=2};

int readPositiveNumber(string message){
  int number;
  do{
  cout<<message<<endl;
  cin>>number;
}while(number<=0);
return number;
}

enPrimeOrNotPtime checkPrime(int number){
  int M=number/2;
  for(int i=2;i<=M;i++){
    if(number%i==0)
    return enPrimeOrNotPtime::notPrime;
  }
  return enPrimeOrNotPtime::prime;
}

void printPrimeNumberFrom1ToN(int n){
    cout<<"The prime numbers from 1 to "<<n<<" are: "<<endl;
    for(int i=1;i<=n;i++){
    if(checkPrime(i)==enPrimeOrNotPtime::prime)
    cout<<i<<endl;
  }
}
int main()
{ 
 printPrimeNumberFrom1ToN(readPositiveNumber("Enter positive number"));
    return 0;
}
