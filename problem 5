#include <iostream>   // Include the iostream library for input/output operations
using namespace std;  // Use the standard namespace to avoid using the "std::" prefix
#include <string>
int readPositiveNumber(string message){
  int number;
  do{
  cout<<message<<endl;
  cin>>number;
}while(number<=0);
return number;
}


void printInReversedOrder(int number){
    int remainder;
    while(number>0){
        remainder=number%10;
        cout<<remainder<<endl;
        number/=10;
    }
}
int main()
{   printInReversedOrder(readPositiveNumber("enter a positve number"));
    
    return 0;
}
