#include <iostream>   // Include the iostream library for input/output operations
using namespace std;  // Use the standard namespace to avoid using the "std::" prefix
#include <string>
#include <cstdlib>
enum enPrimeOrNotPtime{prime=1,notPrime=2};

int readPositiveNumber(string message){
  int number;
  do{
  cout<<message<<endl;
  cin>>number;
}while(number<=0);
return number;
}

enPrimeOrNotPtime checkPrime(int number){
  int M=number/2;
  for(int i=2;i<=M;i++){
    if(number%i==0)
    return enPrimeOrNotPtime::notPrime;
  }
  return enPrimeOrNotPtime::prime;
}

int randomNumber(int from,int to){
    int randNum = rand() % (to - from + 1) + from;
    return randNum;
}

void fillArrayWithRandomNumbers(int arr[],int &size){

    size=readPositiveNumber("Enter the number of elements");
    for(int i=0;i<size;i++){
    arr[i]=randomNumber(1,100);
    }
}

void printArrayElements(int arr[],int size){
    
    for(int i=0;i<size;i++){
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}

void addArrayElement(int arr[],int &size,int number){
    arr[size]=number;
    size++;
}
void copyPrimeNumbers(int arr1[], int arr2[], int size,int &size2)
{
    for (int i = 0; i < size; i++)
    {
        if(checkPrime(arr1[i])==enPrimeOrNotPtime::prime)
        addArrayElement(arr2,size2,arr1[i]);
    }
}




int main()
{   srand((unsigned)time(NULL));
    
    int arr[100];
    int arr2[100];
    int size;
    int size2=0;
    fillArrayWithRandomNumbers(arr,size);
    copyPrimeNumbers(arr,arr2,size,size2);
    cout<<"Array 1 elemnts: "<<endl;
    printArrayElements(arr,size);
    cout<<"Array 2 prime numbers: "<<endl;
    printArrayElements(arr2,size2);
    return 0;
    
}
