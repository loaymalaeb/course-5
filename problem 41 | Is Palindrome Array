#include <string>
#include <cstdlib>

void fillArray(int arr[],int &size){
    
    size=6;
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    arr[3] = 30;
    arr[4] = 20;
    arr[5] = 10;
}

void printArrayElements(int arr[],int size){
    
    for(int i=0;i<size;i++){
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}

bool isPalindromeArray(int arr[],int size){
  for(int i=0;i<size;i++){      
    if(arr[i]!=arr[(size-1)-i])
    return false; 
  }
 return true;
}

int main()
{
    int arr[100];
    int size;
    fillArray(arr,size);
    cout<<"Array elements: "<<endl;
    printArrayElements(arr,size);
    if(isPalindromeArray(arr,size))
    cout<<"Yes array is palindrome"<<endl;
    else
    cout<<"No array is not palindrome"<<endl;
    
    return 0;
    
}
