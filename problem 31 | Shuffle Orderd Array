#include <iostream>   // Include the iostream library for input/output operations
using namespace std;  // Use the standard namespace to avoid using the "std::" prefix
#include <string>
#include <cstdlib>

void swap(int& A, int& B)
{
    int temp;    
    temp = A;    
    A = B;       
    B = temp;    
}

int readPositiveNumber(string message){
  int number;
  do{
  cout<<message<<endl;
  cin>>number;
}while(number<=0);
return number;
}

int randomNumber(int from,int to){
    int randNum = rand() % (to - from + 1) + from;
    return randNum;
}


void printArrayElements(int arr[],int size){
    
    for(int i=0;i<size;i++){
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}

void fillArrayWithOrderdNumbersFrom1ToN(int arr[],int &size){
    size=readPositiveNumber("Enter the number of elements of the array");
    for(int i=0;i<size;i++){
        arr[i]=i+1;
    }
}

void shuffleArray(int arr[],int size){
    for(int i=0;i<size;i++){
        int random=randomNumber(0,size-1);
        swap(arr[i],arr[random]);
    }

}


int main()
{   srand((unsigned)time(NULL));
    int size;
    int arr[100];
    
    fillArrayWithOrderdNumbersFrom1ToN(arr,size);
    cout<<"Array elements before shuffle: "<<endl;
    printArrayElements(arr,size);
    
    shuffleArray(arr,size);
    cout<<"Array elements after shuffle: "<<endl;
    printArrayElements(arr,size);
    return 0;
    
}
