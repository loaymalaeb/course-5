#include <iostream>   // Include the iostream library for input/output operations
using namespace std;  // Use the standard namespace to avoid using the "std::" prefix
#include <string>
int readPositiveNumber(string message){
  int number;
  do{
  cout<<message<<endl;
  cin>>number;
}while(number<=0);
return number;
}


int countDigitFrequency(int number,short digitToCheck){
    int count=0;
    int remainder=0;
    while(number>0){
        remainder=number%10;
        if(remainder==digitToCheck)
        count++;
        number/=10;
    }
    return count;
}

int main()
{   
    int number=readPositiveNumber("enter the main number");
    short digitToCheck=readPositiveNumber("enter one digit to check");
    cout<<"Digit "<<digitToCheck<<" Frequency is "<<countDigitFrequency(number,digitToCheck)<<" time(s)"<<endl;
    return 0;
    
}
