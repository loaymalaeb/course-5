#include <iostream>   // Include the iostream library for input/output operations
using namespace std;  // Use the standard namespace to avoid using the "std::" prefix
#include <string>
int readPositiveNumber(string message){
  int number;
  do{
  cout<<message<<endl;
  cin>>number;
}while(number<=0);
return number;
}


int getReversedNumber(int number){
    string reversed="";
    int remainder=0;
    while(number>0){
        remainder=number%10;
        reversed+=to_string(remainder);
        number/=10;
    }
    return stoi(reversed);
}

void printDigits(int number){
    int remainder;
    while(number>0){
        remainder=number%10;
        cout<<remainder<<endl;
        number/=10;
    }
}

int main()
{   
    printDigits(getReversedNumber(readPositiveNumber("Enter positive number")));
    return 0;
    
}
