void startGame(){
  enRoPaSc playerRoPaSc;
  enRoPaSc computerRoPaSc;
  int rounds=numberOfRounds();
  int player1Wins = 0;
  int computerWins = 0;
  int draws = 0;
  for(int i=1;i<=rounds;i++){
    cout<<"Round ["<<i<<"] begins: "<<endl;
    cout<<endl;
    playerRoPaSc=readPlayerChoice(playerRoPaSc);
    computerRoPaSc=readComputerChoice(computerRoPaSc);
    printRoundWinner(i,playerRoPaSc,computerRoPaSc);

    string winner = showRoundWinner(playerRoPaSc, computerRoPaSc);

    if (winner == "[Player1]")
            player1Wins++;
        else if (winner == "[Computer]")
            computerWins++;
        else
            draws++;
    
  }
  printEndGame();
  printGameResult(rounds,player1Wins,computerWins,draws);
}

