#include <iostream>   // Include the iostream library for input/output operations
using namespace std;  // Use the standard namespace to avoid using the "std::" prefix
#include <string>
#include <cstdlib>

int readPositiveNumber(string message){
  int number;
  do{
  cout<<message<<endl;
  cin>>number;
}while(number<=0);
return number;
}

int randomNumber(int from,int to){
    int randNum = rand() % (to - from + 1) + from;
    return randNum;
}

void fillArrayWithRandomNumbers(int arr[],int &size){

    size=readPositiveNumber("Enter the number of elements");
    for(int i=0;i<size;i++){
    arr[i]=randomNumber(1,100);
    }
}

void printArrayElements(int arr[],int size){
    
    for(int i=0;i<size;i++){
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}

int getIndexInArray(int arr[],int size,int number){
    for(int i=0;i<size;i++){
        if(arr[i]==number)
        return i;
    }
    return -1;
}
int main()
{   srand((unsigned)time(NULL));
    
    int arr[100];
    int size;
    fillArrayWithRandomNumbers(arr,size);
    cout<<"Array 1 elements: "<<endl;
    printArrayElements(arr,size);
    int number=readPositiveNumber("Please enter a number to search for");
    cout<<"Number you are looking for is: "<<number<<endl;
    if(getIndexInArray(arr,size,number)!=-1){
    cout<<"The number found at position: "<<getIndexInArray(arr,size,number)<<endl;
    cout<<"The number found its order: "<<getIndexInArray(arr,size,number)+1<<endl;
    }
    else
    cout<<"The number is not found :("<<endl;
    return 0;
    
}
