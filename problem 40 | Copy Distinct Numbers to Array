#include <iostream>   // Include the iostream library for input/output operations
using namespace std;  // Use the standard namespace to avoid using the "std::" prefix
#include <string>
#include <cstdlib>

void fillArray(int arr[],int &size){
    size=10;
    arr[0] = 10;
    arr[1] = 10;
    arr[2] = 10;
    arr[3] = 50;
    arr[4] = 50;
    arr[5] = 70;
    arr[6] = 70;
    arr[7] = 70;
    arr[8] = 70;
    arr[9] = 90;
}

int getIndexInArray(int arr[],int size,int number){
    for(int i=0;i<size;i++){
        if(arr[i]==number)
        return i;
    }
    return -1;
}

bool isNumberInArray(int arr[],int size,int number){
    return getIndexInArray(arr,size,number)!=-1;
}
void printArrayElements(int arr[],int size){
    
    for(int i=0;i<size;i++){
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}

void addArrayElement(int arr[],int &size,int number){
    arr[size]=number;
    size++;
}
void copyDistinctNumberToArray(int arr1[], int arr2[], int size,int &size2)
{
    for (int i = 0; i < size; i++)
    {
        if(!isNumberInArray(arr2,size2,arr1[i]))
        addArrayElement(arr2,size2,arr1[i]);
    }
}

int main()
{   srand((unsigned)time(NULL));
    
    int arr[100];
    int arr2[100];
    int size;
    int size2=0;
    fillArray(arr,size);
    cout<<"Array 1 elemnts: "<<endl;
    printArrayElements(arr,10);
    copyDistinctNumberToArray(arr,arr2,size,size2);
    cout<<"Array 2 distinct numbers: "<<endl;
    printArrayElements(arr2,size2);
    return 0;
    
}
